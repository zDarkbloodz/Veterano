# ==============================================
# AI RESUME ANALYSIS
# ==============================================

# Groq API (RECOMMENDED - Free, fast, high limits)
# Get your API key from: https://console.groq.com
# Free tier: 14,400 requests/day, 30 req/min
# Models: llama-3.1-70b-versatile (fast & high quality)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (Optional fallback)
# Get your API key from: https://platform.openai.com/api-keys
# Falls back to this if Groq is not configured
OPENAI_API_KEY=your_openai_api_key_here
# ==============================================
# JOB LISTINGS
# ==============================================

# USAJobs API (BEST FOR VETERANS! - Free, government jobs with veteran preference)
# Get your API key from: https://developer.usajobs.gov/APIRequest/Index
# Free tier: Unlimited (for non-commercial use)
# PERFECT for veterans - filters for veteran preference jobs
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_USER_EMAIL=your_email@example.com

# JSearch API via RapidAPI (Aggregates LinkedIn, Indeed, Glassdoor, etc.)
# Get your API key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 2,500 requests/month
# Excellent job coverage from multiple sources
RAPIDAPI_KEY=your_rapidapi_key_here

# Adzuna API (Good for general job search)
# Get your credentials from: https://developer.adzuna.com
# Free tier: 5,000 calls/month
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# RemoteOK API (No auth required - automatic fallback)
# No configuration needed - works out of the box
# Falls back automatically if other APIs not configured

# ==============================================
# DATABASE (Optional for MVP)
# ==============================================

# Supabase
# Get your credentials from: https://supabase.com
# Free tier: 500MB storage, 2GB bandwidth/month
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ==============================================
# APP CONFIGURATION
# ==============================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
